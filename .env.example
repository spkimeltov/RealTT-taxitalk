# --- STT (컨테이너 내장 faster-whisper, GPU 0) ---
WHISPER_MODEL=large-v3
# 공용 STT 컨테이너의 HF 캐시를 읽기 전용으로 마운트한 경로. 여기서 가중치를 찾으면
# 같은 모델을 다시 내려받지 않는다.
WHISPER_CACHE_DIRS=/models/shared
WHISPER_DEVICE=cuda
WHISPER_DEVICE_INDEX=0
WHISPER_COMPUTE_TYPE=float16
# 마이크 2개 모드에서 두 발화가 겹쳐도 각각 처리되도록 최소 2 로 둔다.
STT_WORKERS=2
STT_BEAM_SIZE=5
STT_BEAM_SIZE_PARTIAL=1
STT_API_KEY=sk_eltov_XEGC_RfatLEW0BEGWlXlYkPziKyPvzIEevj6l67vXNg
# 확정 전사의 온도 후퇴 단계. 하나만 두면 후퇴가 없다(기본).
# 여러 단계를 두면 모델이 자신 없는 발화에서 빔 탐색이 무너질 때 다음 온도로 다시
# 디코딩한다. 사투리·비표준 발화를 건지지만 실패한 구간마다 지연이 붙는다.
# 방언을 켤 때 `0.0,0.2,0.4` 로 함께 올린다.
STT_TEMPERATURES=0.0
# 발화 중 중간 자막 주기(초). 0 이면 끄고 GPU 를 아낀다.
PARTIAL_INTERVAL_SEC=1.2
MIN_UTTERANCE_SEC=0.4
# 이 길이를 넘으면 서버가 강제로 발화를 끊는다(브라우저 VAD 가 멈춘 경우의 안전판).
MAX_UTTERANCE_SEC=60

# --- 언어 판별 (마이크 1개 모드에서만 동작) ---
# 중간 자막을 어느 쪽에 띄울지 정하는 임시 추정에만 쓴다. 화자 확정은 발화가 끝난
# 뒤 두 언어로 각각 전사해 점수를 비교해서 한다.
# LID_MARGIN 은 확률 차가 이보다 작을 때 판별이 애매하다고 로그에 남기는 기준이다.
LID_MARGIN=0.15
LID_MIN_SEC=0.8

# --- VAD (브라우저가 실행한다) ---
VAD_RMS_THRESHOLD=0.012
VAD_SILENCE_MS=700
VAD_MIN_SPEECH_MS=250
VAD_PRESPEECH_MS=300

# --- 번역 (vLLM) ---
VLLM_BASE_URL=http://vllm-gpt-oss-120b:8000/v1
VLLM_MODEL=qwen3-coder-next
VLLM_API_KEY=EMPTY
VLLM_TIMEOUT_SEC=60
VLLM_TEMPERATURE=0.2
VLLM_MAX_TOKENS=512
HISTORY_TURNS=3

# --- 방언 (기사의 한국어 발화에만 적용) ---
# 사투리는 두 경로로 다룬다.
#   1. 표준어 변환 — JEJUMA-002 에 발화를 보내 표준어로 옮기고 그것을 번역한다.
#      화면의 "설정 → 마이크 설정 → 지역 사투리 사용" 으로 켜고 끄며, 지역은
#      경상·전라·충청·강원·제주 다섯 가운데 고른다. 아래 JEJUMA_* 절을 채워야 한다.
#   2. 뜻풀이 주석 — 1이 실패하거나 꺼져 있을 때의 폴백. 원문을 고치지 않고
#      app/data/dialect/<지역>.json 의 뜻풀이만 번역 프롬프트에 붙인다.
# 어느 경로든 whisper initial_prompt 에는 사투리 표기를 들려준다. 받아쓰기가 표준어로
# 새면 옮길 사투리가 애초에 남지 않는다.

# 화면 설정과 무관하게 늘 켜 둘 대응표. off 가 기본이다. 화면에서 지역을 고르면
# 그쪽이 이기고, 이 값은 사투리를 끈 세션의 기본값으로만 쓰인다.
KO_DIALECT=off
# 다른 경로의 대응표를 쓸 때만 채운다.
DIALECT_PATH=
# whisper initial_prompt 에 섞을 사투리 예시 수. 용어집 프롬프트와 224 토큰을 나눠
# 쓰므로 늘리면 지명이 밀린다. 대응표에 예시가 12개 있어 그보다 크게 잡아도 소용없다.
DIALECT_PROMPT_WORDS=8
# 번역 프롬프트에 붙일 사투리 뜻풀이 수의 상한.
DIALECT_MAX_NOTES=8
# 설정창에서 지역을 고르지 않았을 때의 기본 지역.
# gyeongsang | jeonla | chungcheong | gangwon | jeju
DIALECT_REGION=gyeongsang
# 체크박스의 초기 상태. 기사가 한 번 바꾸면 그 브라우저에 저장되어 이 값보다 앞선다.
DIALECT_DEFAULT_ON=false

# --- 표준어 변환 (JEJUMA-002 게이트웨이, ETRI A6000) ---
# 개발 중에는 사내망, 배포 서버(ELTOV)에서는 공인 IP 로 나간다. 주소나 키가 비어
# 있으면 변환 경로를 끄고 설정창에서도 체크박스를 감춘다(뜻풀이 폴백만 남는다).
#   개발  http://192.168.0.208:48125
#   배포  http://106.254.227.226:48125
# 배포할 때 -SetEnv 'JEJUMA_BASE_URL=http://106.254.227.226:48125' 로 덮어쓴다.
JEJUMA_BASE_URL=http://192.168.0.208:48125
JEJUMA_API_KEY=
# 이 왕복은 번역 앞에 끼어들므로 넉넉히 잡으면 통역 전체가 늦어진다. 넘기면 사투리
# 원문을 그대로 번역하고 뜻풀이 폴백으로 넘어간다.
JEJUMA_TIMEOUT_SEC=3
JEJUMA_TEMPERATURE=0.1
JEJUMA_MAX_TOKENS=256

# --- 전문용어 ---
# 비워 두면 app/data/glossary/terms.json 을 쓴다(부산 지명 95개 + 관광·운행 용어 29개).
GLOSSARY_PATH=
# whisper initial_prompt 에 넣을 용어 수. 프롬프트는 224 토큰까지만 반영되고 지명은
# 한 개가 길어서(`신세계백화점 센텀시티점`) 32개를 넣으면 한도에 닿는다. 태국어·아랍어
# 처럼 문자당 토큰이 많은 언어를 주로 쓴다면 더 줄인다.
GLOSSARY_PROMPT_TERMS=24

# --- 대화기록 ---
SESSION_DIR=/srv/taxitalk/data/sessions
SESSION_LIST_LIMIT=50

# --- 화면 / 입력 ---
# single = 공용 마이크 1개(언어 판별로 화자 구분), dual = 화면별 마이크 2개(역할 고정)
MIC_MODE=single
# single = 1920x1080 한 화면을 둘이 같이 본다, dual = 3840x1080 좌우 2분할
SCREEN_LAYOUT=single

# --- 서비스 ---
BASE_PATH=/demo/taxitalk
# 값을 넣으면 ?key=... 없이는 접속할 수 없다.
APP_API_KEY=
CLINIC_NAME=
# --- 언어 ---
# 시작 화면에 카드로 뜨는 언어 15개. 한 줄에 일곱 장씩 놓인다. 비워 두면 코드의
# 기본값 (en,ja,zh,yue,th,uz,mn,vi,ru,id,ms,ar,fr,de,es)이 뜬다. 카드는 적은 순서
# 그대로 고정되므로 자주 오는 언어를 앞에 적는다. 탑승객이 고를 수 있는 것은 카드에
# 오른 언어뿐이다.
PATIENT_LANGUAGES=
# 카드에 올릴 수 있는 언어의 범위. 여기서 빠진 코드는 카드에 적어도 무시된다.
# 기본값 all = 카탈로그 34개 전부.
ENABLED_LANGUAGES=all
