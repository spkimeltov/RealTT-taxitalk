# --- STT (컨테이너 내장 faster-whisper, GPU 0) ---
WHISPER_MODEL=large-v3
# 공용 STT 컨테이너의 HF 캐시를 읽기 전용으로 마운트한 경로. 여기서 가중치를 찾으면
# 같은 모델을 다시 내려받지 않는다.
WHISPER_CACHE_DIRS=/models/shared
WHISPER_DEVICE=cuda
WHISPER_DEVICE_INDEX=0
WHISPER_COMPUTE_TYPE=float16
# 마이크 2개 모드에서 두 발화가 겹쳐도 각각 처리되도록 최소 2 로 둔다.
STT_WORKERS=2
STT_BEAM_SIZE=5
STT_BEAM_SIZE_PARTIAL=1
# 발화 중 중간 자막 주기(초). 0 이면 끄고 GPU 를 아낀다.
PARTIAL_INTERVAL_SEC=1.2
MIN_UTTERANCE_SEC=0.4
# 이 길이를 넘으면 서버가 강제로 발화를 끊는다(브라우저 VAD 가 멈춘 경우의 안전판).
MAX_UTTERANCE_SEC=60

# --- 언어 판별 (마이크 1개 모드에서만 동작) ---
# 한국어와 고객 언어의 확률 차가 이보다 작으면 직전 화자의 반대편으로 본다.
LID_MARGIN=0.15
LID_MIN_SEC=0.8

# --- VAD (브라우저가 실행한다) ---
VAD_RMS_THRESHOLD=0.012
VAD_SILENCE_MS=700
VAD_MIN_SPEECH_MS=250
VAD_PRESPEECH_MS=300

# --- 번역 (vLLM) ---
VLLM_BASE_URL=http://vllm-gpt-oss-120b:8000/v1
VLLM_MODEL=qwen3-coder-next
VLLM_API_KEY=EMPTY
VLLM_TIMEOUT_SEC=60
VLLM_TEMPERATURE=0.2
VLLM_MAX_TOKENS=512
HISTORY_TURNS=3

# --- 전문용어 ---
# 비워 두면 app/data/glossary/terms.json 을 쓴다(용어 30개 · 13개 언어 표기).
GLOSSARY_PATH=
# whisper initial_prompt 에 넣을 용어 수. 프롬프트는 224 토큰까지만 반영되므로,
# 태국어·아랍어처럼 문자당 토큰이 많은 언어를 주로 쓴다면 20 안팎으로 줄인다.
GLOSSARY_PROMPT_TERMS=32

# --- 대화기록 ---
SESSION_DIR=/srv/taxitalk/data/sessions
SESSION_LIST_LIMIT=50

# --- 화면 / 입력 ---
# single = 공용 마이크 1개(언어 판별로 화자 구분), dual = 화면별 마이크 2개(역할 고정)
MIC_MODE=single
# single = 1920x1080 한 화면을 둘이 같이 본다, dual = 3840x1080 좌우 2분할
SCREEN_LAYOUT=single

# --- 서비스 ---
BASE_PATH=/demo/taxitalk
# 값을 넣으면 ?key=... 없이는 접속할 수 없다.
APP_API_KEY=
CLINIC_NAME=
# --- 언어 ---
# 시작 화면에 카드로 뜨는 언어 15개. 한 줄에 일곱 장씩 놓인다. 비워 두면 코드의
# 기본값 (en,ja,zh,yue,th,uz,mn,vi,ru,id,ms,ar,fr,de,es)이 뜬다. 카드는 적은 순서
# 그대로 고정되므로 자주 오는 언어를 앞에 적는다. 고객이 고를 수 있는 것은 카드에
# 오른 언어뿐이다.
PATIENT_LANGUAGES=
# 카드에 올릴 수 있는 언어의 범위. 여기서 빠진 코드는 카드에 적어도 무시된다.
# 기본값 all = 카탈로그 34개 전부.
ENABLED_LANGUAGES=all
