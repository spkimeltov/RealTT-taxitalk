{
  "version": 1,
  "dialect": "gyeongsang",
  "label": "경상도(부산·경남) 방언",
  "note": "부산 관광택시 기사·가이드가 쓰는 경상도 말을 알아듣기 위한 대응표. 원문을 표준어로 고쳐 쓰지는 않는다. 방언은 어미 하나로 뜻이 갈리므로 기계적으로 바꾸면 말이 뒤틀린다. `endings` 는 어미의 뜻풀이, `words` 는 어휘의 표준어 뜻이고, 원문에 실제로 나온 것만 번역 프롬프트에 주석으로 붙여 모델이 문장 전체를 보고 번역하게 한다. `prompt_words` 는 whisper 가 사투리를 표준어로 고쳐 받아쓰지 않도록 initial_prompt 에 미리 들려줄 표기다.",
  "false_positives": "표준어 낱말에 파묻히는 표기는 일부러 뺐다. `마이`→마이크, `고마`→고마워, `이자`→利子, `매매`→매매, `마카`→마카롱, 그리고 종결어미 `-소` 는 택시에서 늘 나오는 `주소` 와 겹친다. 종결어미 `-노` 만은 경상도 말의 표지라 넓게 잡는 대신, 노로 끝나는 외래어(아메리카노·카푸치노·카지노·피아노·도미노·토리노)를 부정 룩비하인드로 막았다. 룩비하인드는 `[가-힣]노` 두 글자 앞을 보므로 낱말 전체가 아니라 앞부분만 적는다(아메리카노 → `아메리`). `-나` 는 `하나` `얼마나` `누구나` 처럼 겹치는 표준어가 많아 어간을 나열하는 쪽을 택했다.",

  "prompt_lead": "경상도 사투리가 섞입니다.",
  "prompt_words": [
    "오이소", "가입시다", "왔능교", "갑니꺼", "뭐라카노", "어디 가노",
    "맞나", "억수로", "개안타", "단디", "쪼매", "퍼뜩"
  ],

  "endings": [
    { "id": "iso",
      "pattern": "(?:오|가|보|주|하|사|타|내리|앉으|드시|기다리|말씀하)이소",
      "gloss": "`-이소` 는 `-세요` 에 해당하는 정중한 청유·명령 (오이소 = 오세요)" },

    { "id": "neungyo",
      "pattern": "[가-힣](?:능교|는교)",
      "gloss": "`-능교/-는교` 는 `-습니까` (왔능교 = 왔습니까)" },

    { "id": "nikkeo",
      "pattern": "[가-힣]니꺼",
      "gloss": "`-니꺼` 는 `-니까` (갑니꺼 = 갑니까)" },

    { "id": "ipsida",
      "pattern": "(?:가|하|보|묵|사|타|쉬|기다리)입시다",
      "gloss": "`-입시다` 는 `-읍시다` (가입시다 = 갑시다)" },

    { "id": "no",
      "pattern": "(?<!아메리)(?<!카푸)(?<!카)(?<!피)(?<!도)(?<!토)[가-힣]노(?=[\\s.,!?…\"')\\]]|$)",
      "gloss": "`-노` 는 무엇·어디를 묻는 의문 종결 (어디 가노 = 어디 가니)" },

    { "id": "na",
      "pattern": "(?:맞|있|없|왔|갔|봤|묵었|먹었|했|됐|모르|아|가|오|타|사|주|살|남|좋|많|괜찮|걸리|남았|끝났|들었)나(?=[\\s.,!?…\"')\\]]|$)",
      "gloss": "`-나` 는 예·아니오를 묻는 의문 종결 (맞나 = 맞니)" },

    { "id": "ye",
      "pattern": "[가-힣](?:아예|어예|해예|네예|지예|라예|다예)(?=[\\s.,!?…\"')\\]]|$)",
      "gloss": "`-예` 는 `-요` 에 해당하는 부산 특유의 존대 종결 (맞아예 = 맞아요)" },

    { "id": "dei",
      "pattern": "(?:하|가|오|있|먹|묵|보|자|쉬|좋|많|맛있|시원|따뜻|재밌|괜찮|조심하|잘하)데이(?=[\\s.,!?…\"')\\]]|$)",
      "gloss": "`-데이` 는 다짐·당부를 담은 친근한 종결 (조심하데이 = 조심해라)" },

    { "id": "rakko",
      "pattern": "[가-힣]라꼬",
      "gloss": "`-라꼬` 는 `-려고` (갈라꼬 = 가려고)" },

    { "id": "kada",
      "pattern": "(?:머라|뭐라|그|이|저|안)카(?:노|나|는|고|데|이|더)",
      "gloss": "`-카다` 는 `-라고 하다` (뭐라카노 = 뭐라고 하니)" },

    { "id": "aiga",
      "pattern": "(?:다|지|제|네|나)\\s*아이가",
      "gloss": "`아이가` 는 `-잖아` 로 확인을 구하는 말 (맞다 아이가 = 맞잖아)" }
  ],

  "words": [
